# Copy to .env and fill in. Never commit .env.

# TypeSafe (System One / Jev) - used to judge and rank Shorts and to QA generated scripts.
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Script writing, one of:
#  (a) an Anthropic API key, or
#  (b) your Claude Pro/Max subscription via Claude Code headless mode: run `claude setup-token` once
#      in a terminal (opens a browser) and paste the token below.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: path to claude.exe if it is not on PATH (the desktop app's bundled copy is found automatically).
CLAUDE_CODE_BIN=

# Optional: Pexels stock footage for backgrounds (free key at https://www.pexels.com/api/).
# Without it the renderer uses a generated motion background.
PEXELS_API_KEY=

# Optional: YouTube Data API. Needed only for `upload` (and optionally `discover --api`).
# See README "YouTube upload setup".
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS=client_secrets.json
